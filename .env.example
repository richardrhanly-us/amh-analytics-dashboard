# ==============================================================================
# SortView -- environment variable reference
#
# This is a documentation template, not a loader: nothing in this repo reads
# a .env file automatically (no python-dotenv is installed). Copy the
# variables you need into whatever actually sets env vars for each
# deployment target -- shell/environment configuration or a process manager
# configured to load an environment file for local development, Streamlit
# Cloud's Secrets panel, the AMH machine's scheduled task environment, CI
# secrets, etc.
#
# Three deployment targets read from this list, and most variables belong to
# only one of them. See the "environment variables" table in
# docs/deployment.md for the authoritative per-target breakdown (backend API
# vs. Streamlit dashboard vs. AMH agent) and which are required vs. optional.
# ==============================================================================

# ------------------------------------------------------------------------------
# Shared -- backend API and Streamlit dashboard both read this
# ------------------------------------------------------------------------------

# Postgres connection string (Neon). Required by both the backend API and the
# dashboard. On Streamlit Cloud this is normally set via the app's Secrets
# panel instead of a real env var -- src/database.py falls back to
# st.secrets["DATABASE_URL"] if the env var isn't set.
DATABASE_URL=postgresql://user:password@host/dbname

# ------------------------------------------------------------------------------
# Backend API (main.py / FastAPI)
# ------------------------------------------------------------------------------

# Sentry error tracking. Optional -- leave unset/blank to disable Sentry
# entirely. Tests explicitly clear SENTRY_DSN in tests/conftest.py so local
# developer Sentry settings cannot leak into the test suite.
SENTRY_DSN=

# Environment tag attached to Sentry events. Only meaningful if SENTRY_DSN is set.
SENTRY_ENVIRONMENT=development

# Rate limit applied to /upload and /upload-pipeline-status, slowapi format.
SORTVIEW_UPLOAD_RATE_LIMIT=30/minute

# Max accepted request body size in bytes before a request is rejected with 413.
SORTVIEW_MAX_REQUEST_BODY_BYTES=5242880

# Comma-separated CORS allow-list for browser clients that call the FastAPI
# backend directly. Add only the trusted web origins that actually need
# cross-origin API access.
SORTVIEW_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ------------------------------------------------------------------------------
# Streamlit dashboard (src/)
# ------------------------------------------------------------------------------

# Guest/demo login. The guest-login code path is unreachable unless
# SORTVIEW_DEMO_MODE_ENABLED is explicitly "true" -- do not set any of these
# three in a real customer deployment.
SORTVIEW_DEMO_MODE_ENABLED=false
SORTVIEW_GUEST_EMAIL=
SORTVIEW_GUEST_PASSWORD=

# Password reset emails (src/services/email_service.py). These five are
# required together the first time a user requests a password reset --
# missing any of them raises at send time, not at app startup.
SORTVIEW_APP_URL=http://localhost:8501
SORTVIEW_SMTP_HOST=
SORTVIEW_SMTP_PORT=587
SORTVIEW_SMTP_USERNAME=
SORTVIEW_SMTP_PASSWORD=
SORTVIEW_EMAIL_FROM=

# Load data from local files instead of the database. Leave "false" outside
# of local development against sample files.
SORTVIEW_ALLOW_FILE_FALLBACK=false

# How often (seconds) the dashboard auto-refreshes live data during
# operating hours (6am-9pm Central). Only affects live/status loaders --
# historical loaders are unaffected and keep their own 900s cache TTL.
# Non-positive or non-integer values fall back to 10 automatically.
SORTVIEW_DASHBOARD_REFRESH_SECONDS=10

# Column name overrides for tenant scoping. Only needed if a deployment's
# org/branch columns are named differently from the defaults shown here.
SORTVIEW_CHECKINS_ORG_COLUMN=customer_id
SORTVIEW_CHECKINS_BRANCH_COLUMN=branch_id
SORTVIEW_REJECTS_ORG_COLUMN=customer_id
SORTVIEW_REJECTS_BRANCH_COLUMN=branch_id
SORTVIEW_ACS_ORG_COLUMN=customer_id
SORTVIEW_ACS_BRANCH_COLUMN=branch_id
SORTVIEW_PIPELINE_ORG_COLUMN=customer_id
SORTVIEW_PIPELINE_BRANCH_COLUMN=branch_id

# Timezone used for "live today" metrics.
SORTVIEW_LIVE_TIMEZONE=America/Chicago

# ------------------------------------------------------------------------------
# AMH agent (agent/) -- runs on the Windows machine at the AMH, not in this
# repo's normal deployment targets
# ------------------------------------------------------------------------------

# Bearer token the agent sends to authenticate uploads. Checked against a
# per-branch token stored in the agent_tokens table -- there is no
# corresponding env var on the backend side to keep in sync.
SORTVIEW_API_TOKEN=

# HTTP client tuning for agent -> backend calls.
SORTVIEW_HTTP_CONNECT_TIMEOUT=10
SORTVIEW_HTTP_UPLOAD_READ_TIMEOUT=300
SORTVIEW_HTTP_STATUS_READ_TIMEOUT=60
SORTVIEW_HTTP_RETRY_TOTAL=3
SORTVIEW_HTTP_RETRY_BACKOFF_FACTOR=1.0
SORTVIEW_MAX_RECORDS_PER_REQUEST=1000
SORTVIEW_MAX_LOG_RESPONSE_CHARS=500

# Local SQLite outbox maintenance (agent/maintenance.py, Continuous
# Ingestion Phase 5: Sustain) -- prunes old delivered rows and checkpoints
# the WAL file. Entirely local; none of this affects uploads to the
# backend. Non-positive or non-integer values fall back to the defaults
# shown here automatically.

# How many days a delivered row is kept before it becomes eligible for
# pruning. Pending and quarantined rows are never auto-pruned regardless
# of age.
SORTVIEW_OUTBOX_DELIVERED_RETENTION_DAYS=7

# Max rows deleted per prune batch (one bounded transaction, committed
# before the next batch starts).
SORTVIEW_OUTBOX_PRUNE_BATCH_SIZE=1000

# Max number of prune batches one maintenance cycle may run, so a very
# large eligible backlog drains gradually across cycles instead of in one
# long-running cycle.
SORTVIEW_OUTBOX_MAINTENANCE_MAX_BATCHES_PER_CYCLE=10

# How often (seconds) the maintenance cycle runs -- independent of the
# uploader's 2-5s poll cadence. Retention is measured in days, so
# sub-minute precision isn't useful here.
SORTVIEW_OUTBOX_MAINTENANCE_INTERVAL_SECONDS=3600

# Busy-wait timeout for the maintenance component's own SQLite connection.
# Deliberately much shorter than the 30s the other components use: a WAL
# checkpoint under contention blocks the calling thread for up to this
# value before giving up, so a short timeout here bounds that worst case
# to a few seconds instead of thirty. None of this component's work is
# time-critical -- failing fast and retrying next cycle is preferable.
SORTVIEW_OUTBOX_MAINTENANCE_BUSY_TIMEOUT_SECONDS=5

# Max pages reclaimed by one incremental_vacuum call. Only takes effect on
# databases created with incremental auto_vacuum (new databases as of
# Phase 5) -- a silent no-op on any existing database, which stays at
# whatever auto_vacuum mode it was created with. See docs/deployment.md.
SORTVIEW_OUTBOX_MAX_INCREMENTAL_VACUUM_PAGES=1000

# Backoff after a failed maintenance cycle (exponential, base -> max).
# Does not affect the normal once-per-interval cadence on success.
SORTVIEW_OUTBOX_MAINTENANCE_BACKOFF_BASE_SECONDS=60
SORTVIEW_OUTBOX_MAINTENANCE_BACKOFF_MAX_SECONDS=3600
SORTVIEW_OUTBOX_MAINTENANCE_BACKOFF_MULTIPLIER=2

# Non-secret, per-site agent config (customer_id, branch_id, api_url, local
# file paths) lives in agent/agent_config.json on the AMH machine, not in
# environment variables -- see docs/deployment.md.

# ------------------------------------------------------------------------------
# Uptime / pipeline health monitoring (scripts/check_uptime.py,
# scripts/check_pipeline_health.py) -- runs from GitHub Actions on a
# schedule, not from the backend or dashboard. See docs/monitoring.md.
# ------------------------------------------------------------------------------

# Public URL of the deployed backend API, used only by the uptime check.
# Different from SORTVIEW_APP_URL above, which points at the dashboard.
SORTVIEW_API_BASE_URL=https://api.example.com

# Comma-separated recipient list for both monitoring scripts' alert emails.
# Reuses the SORTVIEW_SMTP_* / SORTVIEW_EMAIL_FROM settings above. Leave
# unset to run the checks without email alerts (they still exit non-zero
# and print details on failure).
SORTVIEW_ALERT_EMAIL_TO=

# How many minutes a branch can go without a pipeline_status update before
# it's considered stale. Has no universally correct value -- tune it to
# comfortably exceed how often that branch's AMH agent is actually
# scheduled to run.
SORTVIEW_PIPELINE_STALE_MINUTES=60
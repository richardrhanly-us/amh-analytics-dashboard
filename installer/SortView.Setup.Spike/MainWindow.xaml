<Window x:Class="SortView.Setup.Spike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SortView Installer — Phase 3C test window — SIMULATION ONLY"
        Width="1100" Height="800"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#B00020" Padding="12,8">
            <TextBlock x:Name="SimulationBanner" Foreground="White" FontWeight="Bold" TextWrapping="Wrap" FontSize="14"
                       Text="SIMULATION ONLY — the real setup engine runs against a generated mock bundle. Nothing is installed, no network request is made, no credential is stored and no Scheduled Task is changed. Do not enter a real enrollment code." />
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="12,8,12,0">
            <WrapPanel>
                <GroupBox Header="Simulated server" Margin="0,0,12,0" Padding="6">
                    <StackPanel>
                        <RadioButton x:Name="ScenarioLegacy" GroupName="Contract" Content="Legacy contract (v1, with the v2 fallback)" IsChecked="True" />
                        <RadioButton x:Name="ScenarioV2" GroupName="Contract" Content="Contract v2" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Make the next run fail" Margin="0,0,12,0" Padding="6">
                    <StackPanel>
                        <RadioButton x:Name="FaultNone" GroupName="Fault" Content="Do not fail" IsChecked="True" />
                        <RadioButton x:Name="FaultInstall" GroupName="Fault" Content="During install (then resume)" />
                        <RadioButton x:Name="FaultVerification" GroupName="Fault" Content="During verification (then resume)" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Simulated machine" Padding="6">
                    <StackPanel>
                        <CheckBox x:Name="StandardFilesPresent" Content="Standard Tech Logic files present" IsChecked="True" />
                        <CheckBox x:Name="SlowSteps" Content="Slow simulated steps (3 s each)" />
                    </StackPanel>
                </GroupBox>
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="StartButton" Content="_Start simulated setup" Padding="12,4" Margin="0,0,8,0" Click="StartButton_Click" />
                <Button x:Name="CancelButton" Content="_Cancel setup" Padding="12,4" Margin="0,0,8,0" Click="CancelButton_Click" IsEnabled="False" />
                <Button x:Name="NewMachineButton" Content="_New simulated machine" Padding="12,4" Click="NewMachineButton_Click" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Text="Ready." />
            <TextBlock x:Name="CancelNote" Margin="0,4,0,0" Foreground="#8A4B00" TextWrapping="Wrap" Text="" />
            <TextBlock x:Name="WorkspacePath" Margin="0,4,0,0" Foreground="#555" TextWrapping="Wrap" Text="" />

            <Border x:Name="PromptPanel" Margin="0,8,0,0" Padding="10" BorderBrush="#1F4E79" BorderThickness="2" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="PromptId" Foreground="#555" Text="none" />
                    <TextBlock x:Name="PromptTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="PromptDetails" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <WrapPanel x:Name="ChoiceRow" Margin="0,8,0,0">
                        <Button x:Name="PromptPrimary" Padding="12,4" Margin="0,0,8,0" Click="PromptPrimary_Click" />
                        <Button x:Name="PromptSecondary" Padding="12,4" Margin="0,0,8,0" Click="PromptSecondary_Click" />
                    </WrapPanel>
                    <DockPanel x:Name="PathRow" Margin="0,8,0,0" LastChildFill="True">
                        <Button x:Name="UsePathButton" DockPanel.Dock="Right" Content="_Use this path" Padding="10,2" Margin="8,0,0,0" Click="UsePathButton_Click" />
                        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="_Browse…" Padding="10,2" Margin="8,0,0,0" Click="BrowseButton_Click" />
                        <TextBox x:Name="PathBox" AutomationProperties.Name="Source file path" TextChanged="PathBox_TextChanged" />
                    </DockPanel>
                    <DockPanel x:Name="CodeRow" Margin="0,8,0,0" LastChildFill="True">
                        <Button x:Name="EnrollButton" DockPanel.Dock="Right" Content="_Enroll" Padding="10,2" Margin="8,0,0,0" Click="EnrollButton_Click" />
                        <PasswordBox x:Name="CodeBox" AutomationProperties.Name="Dummy enrollment code (simulation only)" />
                    </DockPanel>
                    <Button x:Name="PromptCancel" HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,0" Click="PromptCancel_Click" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Setup events (structured)" />
                <ListBox x:Name="EventList" AutomationProperties.Name="Setup events" VirtualizingPanel.IsVirtualizing="False" />
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Console text (diagnostics, kept in memory only)" />
                <ListBox x:Name="DiagnosticList" AutomationProperties.Name="Console text" VirtualizingPanel.IsVirtualizing="False" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

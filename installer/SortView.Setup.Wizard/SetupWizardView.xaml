<UserControl x:Class="SortView.Setup.Wizard.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- The seven customer steps, worked out from the engine's events (SetupProgress). Each says its state in words;
             a screen reader reads each step as one line ("Step 4 of 7: Enroll this computer, Working"). -->
        <GroupBox x:Name="ProgressPanel" DockPanel.Dock="Left" Width="270" Margin="12,8,0,12" Padding="8,6" Header="Setup steps">
            <ItemsControl x:Name="ProgressSteps" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" AutomationProperties.Name="{Binding AccessibleName}"><Run Text="{Binding Number, Mode=OneWay}" /><Run Text=". " /><Run Text="{Binding Title, Mode=OneWay}" /><LineBreak /><Run x:Name="StepState" FontSize="12" Foreground="#555555" Text="{Binding StateLabel, Mode=OneWay}" /></TextBlock>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Working">
                                <Setter TargetName="StepState" Property="FontWeight" Value="Bold" />
                                <Setter TargetName="StepState" Property="Foreground" Value="#1F4E79" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="WaitingForAnswer">
                                <Setter TargetName="StepState" Property="FontWeight" Value="Bold" />
                                <Setter TargetName="StepState" Property="Foreground" Value="#1F4E79" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Done">
                                <Setter TargetName="StepState" Property="Foreground" Value="#1E6B2E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="DoneEarlier">
                                <Setter TargetName="StepState" Property="Foreground" Value="#1E6B2E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="LeftDisabled">
                                <Setter TargetName="StepState" Property="Foreground" Value="#8A4B00" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="StoppedHere">
                                <Setter TargetName="StepState" Property="FontWeight" Value="Bold" />
                                <Setter TargetName="StepState" Property="Foreground" Value="#B00020" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <StackPanel DockPanel.Dock="Top" Margin="12,8,12,0">
            <TextBlock x:Name="InstallationNotice" FontWeight="SemiBold" Foreground="#8A4B00" TextWrapping="Wrap" Margin="0,0,0,8" />
            <WrapPanel>
                <Button x:Name="StartButton" Content="_Install" Padding="12,4" Margin="0,0,8,0" Click="StartButton_Click" />
                <Button x:Name="CancelButton" Content="_Cancel setup" Padding="12,4" Margin="0,0,8,0" Click="CancelButton_Click" IsEnabled="False" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Text="Ready." />
            <TextBlock x:Name="CancelNote" Margin="0,4,0,0" Foreground="#8A4B00" TextWrapping="Wrap" Text="" />

            <!-- Said once the engine reports an unfinished earlier setup (mode_detected), and again once it resumes it. -->
            <Border x:Name="ResumeBanner" Margin="0,8,0,0" Padding="8" BorderBrush="#1F4E79" BorderThickness="1" Background="#EEF4FA" Visibility="Collapsed">
                <TextBlock x:Name="ResumeText" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <!-- What setup is doing: changes only when a customer step does, so a screen reader hears steps, not events. -->
            <TextBlock x:Name="CurrentStepText" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
            <ProgressBar x:Name="BusyIndicator" Height="6" Margin="0,6,0,0" Visibility="Collapsed" AutomationProperties.Name="Setup is working" />

            <!-- One question at a time, asked by the setup engine. Each kind of question has its own view; the engine
                 decides when it is asked, whether an answer is acceptable and what it means. -->
            <GroupBox x:Name="PromptPanel" Header="Setup needs your answer" Margin="0,8,0,0" Padding="8" BorderBrush="#1F4E79" BorderThickness="2" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="PromptId" Foreground="#888" FontSize="10" Text="none" />
                    <TextBlock x:Name="PromptTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

                    <!-- sources_confirm -->
                    <StackPanel x:Name="SourcesConfirmView" Margin="0,8,0,0">
                        <TextBlock TextWrapping="Wrap" Text="Setup found the three Tech Logic files the Collector reads:" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" FontWeight="SemiBold" Margin="0,0,12,2" Text="Checkins" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StandardCheckinsPath" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" FontWeight="SemiBold" Margin="0,0,12,2" Text="Rejects" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StandardRejectsPath" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" FontWeight="SemiBold" Margin="0,0,12,2" Text="ACS" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StandardAcsPath" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock x:Name="SourcesNetworkWarning" Margin="0,6,0,0" Foreground="#8A4B00" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="UseStandardFilesButton" Content="_Use these files" Padding="12,4" Margin="0,0,8,0" Click="UseStandardFilesButton_Click" />
                            <Button x:Name="ChooseOtherFilesButton" Content="C_hoose other files" Padding="12,4" Margin="0,0,8,0" Click="ChooseOtherFilesButton_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- source_path -->
                    <StackPanel x:Name="SourcePathView" Margin="0,8,0,0">
                        <TextBlock x:Name="SourceDescription" TextWrapping="Wrap" />
                        <TextBlock x:Name="SourceAttempt" Margin="0,4,0,0" Foreground="#555" />
                        <TextBlock x:Name="SourceProblem" Margin="0,4,0,0" Foreground="#B00020" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <DockPanel Margin="0,8,0,0" LastChildFill="True">
                            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="_Browse…" Padding="10,2" Margin="8,0,0,0" Click="BrowseButton_Click" />
                            <TextBox x:Name="PathBox" AutomationProperties.Name="Source file path" TextChanged="PathBox_TextChanged" />
                        </DockPanel>
                        <TextBlock x:Name="PathNetworkWarning" Margin="0,6,0,0" Foreground="#8A4B00" TextWrapping="Wrap" />
                        <Button x:Name="UsePathButton" HorizontalAlignment="Left" Content="_Use this file" Padding="12,4" Margin="0,10,0,0" Click="UsePathButton_Click" />
                    </StackPanel>

                    <!-- resume_confirm -->
                    <StackPanel x:Name="ResumeView" Margin="0,8,0,0">
                        <TextBlock x:Name="ResumeExplanation" TextWrapping="Wrap" />
                        <TextBlock x:Name="ResumeDetails" Margin="0,6,0,0" Foreground="#555" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="ResumeButton" Content="_Resume setup" Padding="12,4" Margin="0,0,8,0" Click="ResumeButton_Click" />
                            <Button x:Name="DontResumeButton" Content="_Do not resume" Padding="12,4" Margin="0,0,8,0" Click="DontResumeButton_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- enrollment_code -->
                    <StackPanel x:Name="EnrollmentView" Margin="0,8,0,0">
                        <TextBlock x:Name="EnrollmentExplanation" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="The code works only once. Setup sends it a single time; if enrollment does not succeed, setup stops and tells you whether the same code can be used again." />
                        <DockPanel Margin="0,8,0,0" LastChildFill="True">
                            <Button x:Name="EnrollButton" DockPanel.Dock="Right" Content="_Enroll" Padding="12,2" Margin="8,0,0,0" Click="EnrollButton_Click" IsEnabled="False" />
                            <PasswordBox x:Name="CodeBox" AutomationProperties.Name="Enrollment code" PasswordChanged="CodeBox_PasswordChanged" />
                        </DockPanel>
                    </StackPanel>

                    <!-- legacy_task_enable -->
                    <StackPanel x:Name="TaskEnableView" Margin="0,8,0,0">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Enabling starts the recurring 15-minute runs. Leaving it disabled, or cancelling, keeps it disabled." />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="EnableTaskButton" Content="E_nable" Padding="12,4" Margin="0,0,8,0" Click="EnableTaskButton_Click" />
                            <Button x:Name="LeaveTaskDisabledButton" Content="_Leave disabled" Padding="12,4" Margin="0,0,8,0" Click="LeaveTaskDisabledButton_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <Button x:Name="PromptCancel" HorizontalAlignment="Left" Padding="12,4" Margin="0,10,0,0" Click="PromptCancel_Click" />
                </StackPanel>
            </GroupBox>

            <!-- How the run ended: what to do now (StopGuidance), then the engine's own words, unchanged. -->
            <GroupBox x:Name="OutcomePanel" Header="Result" Margin="0,8,0,0" Padding="8" BorderThickness="2" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="OutcomeTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="OutcomeSummary" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="OutcomeActionHeading" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="OutcomeAction" Margin="0,2,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="OutcomeDetailsHeading" Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="OutcomeStepLabel" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="OutcomeProblem" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="OutcomeUnchanged" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="OutcomeAdvice" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="OutcomeFix" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <StackPanel x:Name="CopyDetailsPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                        <Button x:Name="CopyDetailsButton" Content="C_opy details" Padding="12,4" Click="CopyDetailsButton_Click"
                                AutomationProperties.HelpText="Copies a summary for SortView support. It holds no enrollment code, token, secret, file path or setup log." />
                        <TextBlock x:Name="CopyStatus" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- The engine's events and console text, unchanged, for diagnosis. Hosts choose whether it starts open. -->
        <Expander x:Name="DetailsExpander" Header="Show details" Margin="12" IsExpanded="False">
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Details: setup events" />
                <ListBox x:Name="EventList" AutomationProperties.Name="Setup events" VirtualizingPanel.IsVirtualizing="False" />
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Details: setup log (kept in memory only)" />
                <ListBox x:Name="DiagnosticList" AutomationProperties.Name="Console text" VirtualizingPanel.IsVirtualizing="False" />
            </DockPanel>
        </Grid>
        </Expander>
    </DockPanel>
</UserControl>

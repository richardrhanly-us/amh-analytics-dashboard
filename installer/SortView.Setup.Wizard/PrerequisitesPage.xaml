<UserControl x:Class="SortView.Setup.Wizard.PrerequisitesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Check this computer" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Setup only looks at this computer here; it changes nothing. A failed check, or a required check that could not be completed, must be resolved before you can continue." />
            <DockPanel Margin="0,12,0,8">
                <Button x:Name="CheckAgainButton" DockPanel.Dock="Right" Content="Check _again" Padding="12,4" Click="CheckAgainButton_Click" />
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" Text="Not checked yet." />
            </DockPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ResultsList" AutomationProperties.Name="Prerequisite results">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="10,6" BorderBrush="#CCCCCC" BorderThickness="1"
                                AutomationProperties.AutomationId="{Binding Id}" AutomationProperties.Name="{Binding Title}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StatusLabel" Grid.Column="0" FontWeight="Bold" Text="{Binding StatusLabel}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding Detail}" />
                                    <TextBlock x:Name="ResolutionText" TextWrapping="Wrap" FontStyle="Italic" Text="{Binding Resolution}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Passed">
                                <Setter TargetName="StatusLabel" Property="Foreground" Value="#1E6B2E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                <Setter TargetName="StatusLabel" Property="Foreground" Value="#8A4B00" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                <Setter TargetName="StatusLabel" Property="Foreground" Value="#B00020" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="NotChecked">
                                <Setter TargetName="StatusLabel" Property="Foreground" Value="#555555" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Resolution}" Value="">
                                <Setter TargetName="ResolutionText" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<!-- The setup wizard's screens, shared by the production program (SortView.Setup) and the simulation host
     (SortView.Setup.Spike). It runs whatever setup its host hands it and never chooses one itself: it references only
     the Core and WPF bridges, never a simulation or testing assembly. -->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <RootNamespace>SortView.Setup.Wizard</RootNamespace>
    <AssemblyName>SortView.Setup.Wizard</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <ProjectTypeGuids>{60dc8134-eba5-43b8-bcc9-bb4bc16c2548};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <Prefer32Bit>false</Prefer32Bit>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SortView.Setup.Core\SortView.Setup.Core.csproj">
      <Name>SortView.Setup.Core</Name>
    </ProjectReference>
    <ProjectReference Include="..\SortView.Setup.Wpf\SortView.Setup.Wpf.csproj">
      <Name>SortView.Setup.Wpf</Name>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Page Include="SetupWizardView.xaml" />
    <Compile Include="SetupWizardView.xaml.cs">
      <DependentUpon>SetupWizardView.xaml</DependentUpon>
    </Compile>
    <Page Include="WelcomePage.xaml" />
    <Compile Include="WelcomePage.xaml.cs">
      <DependentUpon>WelcomePage.xaml</DependentUpon>
    </Compile>
    <Page Include="PrerequisitesPage.xaml" />
    <Compile Include="PrerequisitesPage.xaml.cs">
      <DependentUpon>PrerequisitesPage.xaml</DependentUpon>
    </Compile>
    <Page Include="ReadyPage.xaml" />
    <Compile Include="ReadyPage.xaml.cs">
      <DependentUpon>ReadyPage.xaml</DependentUpon>
    </Compile>
    <Compile Include="PrerequisiteChecks.cs" />
    <Compile Include="SetupProgress.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>

<UserControl x:Class="SortView.Setup.Wizard.PreparePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Checking and copying the installation package before setup. Its host decides what it says: this page only shows
         it. The stage line is a live region announced once per stage; the file count is not announced. -->
    <StackPanel Margin="24,20" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Prepare the installation files" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="14"
                   Text="Setup checks the SortView Collector installation package against the one this setup program trusts, then copies it to a protected folder. Nothing is installed in this step." />
        <TextBlock x:Name="StageText" Margin="0,16,0,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="CountText" Margin="0,4,0,0" TextWrapping="Wrap" />
        <ProgressBar x:Name="BusyIndicator" Height="6" Margin="0,8,0,0" Visibility="Collapsed"
                     AutomationProperties.Name="Preparing the installation files" />
        <TextBlock x:Name="DetailText" Margin="0,8,0,0" TextWrapping="Wrap" />
        <WrapPanel Margin="0,12,0,0">
            <Button x:Name="CancelPrepareButton" Content="_Cancel" Padding="12,4" Margin="0,0,8,0" Visibility="Collapsed"
                    Click="CancelPrepareButton_Click" />
            <Button x:Name="RetryButton" Content="_Try again" Padding="12,4" Margin="0,0,8,0" Visibility="Collapsed"
                    Click="RetryButton_Click" />
        </WrapPanel>
        <Border x:Name="EarlierRunsNotice" Margin="0,16,0,0" Padding="8" BorderBrush="#1F4E79" BorderThickness="1"
                Background="#EEF4FA" Visibility="Collapsed">
            <TextBlock x:Name="EarlierRunsText" TextWrapping="Wrap" />
        </Border>
        <Expander x:Name="DetailsExpander" Header="Show details" Margin="0,12,0,0" Visibility="Collapsed">
            <ItemsControl x:Name="DetailsList" Margin="0,6,0,0" Focusable="False" />
        </Expander>
    </StackPanel>
</UserControl>

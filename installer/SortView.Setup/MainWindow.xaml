<Window x:Class="SortView.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wizard="clr-namespace:SortView.Setup.Wizard;assembly=SortView.Setup.Wizard"
        Title="SortView Setup" Width="1000" Height="720" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F4E79" Padding="12,10">
            <TextBlock x:Name="ProductTitle" Foreground="White" FontWeight="Bold" FontSize="18" Text="SortView Setup" />
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="&lt; _Back" Padding="16,4" Margin="0,0,8,0" Click="BackButton_Click" />
                <Button x:Name="NextButton" Content="_Next &gt;" Padding="16,4" Margin="0,0,16,0" Click="NextButton_Click" IsDefault="True" />
                <Button x:Name="ExitButton" Content="E_xit" Padding="16,4" Click="ExitButton_Click" />
            </StackPanel>
        </Border>
        <Grid>
            <wizard:WelcomePage x:Name="WelcomeView" />
            <wizard:PrerequisitesPage x:Name="PrerequisitesView" Visibility="Collapsed" />
            <wizard:SetupWizardView x:Name="Wizard" Visibility="Collapsed" IsInstallationEnabled="False"
                DisabledNotice="Installation is not yet enabled in this build. Nothing will be installed or changed on this computer." />
        </Grid>
    </DockPanel>
</Window>

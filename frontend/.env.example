# SortView frontend environment. Copy to .env.local for local overrides
# (.env.local is git-ignored). Nothing here is a secret: every VITE_* value
# is compiled into the JavaScript a browser downloads.

# Prefix for the API requests the browser sends. Leave EMPTY for the intended
# setup: same-origin requests to /api (the page and the API are served under
# one hostname). Set it only if the API is on another origin; a trailing
# slash is ignored.
VITE_API_BASE_URL=

# Development only, and deliberately NOT prefixed with VITE_ so it is never
# bundled. When set, `npm run dev` forwards /api to this address, so the
# browser still talks to one origin (http://localhost:5173). Empty means no
# proxy. Point it at a LOCAL backend only, for example http://127.0.0.1:8000.
# That backend must be started with:
#   SORTVIEW_CUSTOMER_ALLOWED_ORIGINS=http://localhost:5173
#   SORTVIEW_CUSTOMER_COOKIE_SECURE=false
DEV_API_PROXY_TARGET=

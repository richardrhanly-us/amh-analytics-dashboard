# SortView frontend environment. Copy to .env.local for local overrides
# (.env.local is git-ignored). Nothing here is a secret: every VITE_* value
# is compiled into the JavaScript a browser downloads.
#
# Block F1 is a scaffold only. Neither variable below is read by any code
# yet; they are written down now so later blocks have one agreed contract.

# Base URL the browser will send API requests to. Leave EMPTY for the
# intended setup: same-origin requests to /api (the page and the API are
# served under one hostname). Set it only if the API is on another origin.
VITE_API_BASE_URL=

# Development only, and deliberately NOT prefixed with VITE_ so it is never
# bundled. Reserved for the Vite dev server: where it will forward /api to
# when a local backend is running (for example http://127.0.0.1:8000).
# Unused until the API client is added in a later block.
DEV_API_PROXY_TARGET=
